# ParceFlyte environment configuration
#
# The app runs with NO configuration at all: with none of these set it starts in
# DEMO MODE, using an in-memory seeded dataset and a fixed demo user.
# Set the variables below to run against real infrastructure.
#
# A production deployment with MONGODB_URI set MUST also set the Auth0
# variables — without them it refuses to serve requests rather than treat every
# visitor as the demo admin.

# --- Demo mode -------------------------------------------------------------
# Force the in-memory dataset on even when MONGODB_URI is configured.
# NEXT_PUBLIC_DEMO_MODE=true

# --- Database --------------------------------------------------------------
# Setting this switches persistence from the in-memory store to MongoDB.
# Indexes are created automatically on first connection.
# MONGODB_URI=mongodb://localhost:27017/parceflyte

# --- Auth0 -----------------------------------------------------------------
# Setting all five switches auth from the demo session to real Auth0 sign-in.
# Generate the secret with: openssl rand -hex 32
# AUTH0_SECRET=
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# --- Admins ----------------------------------------------------------------
# Comma-separated emails granted the admin role when they sign in with a
# verified email address.
# ADMIN_EMAILS=you@example.com
