# ParceFlyte environment configuration
#
# The app runs with NO configuration at all: with none of these set it starts in
# DEMO MODE, using an in-memory seeded dataset and a mock signed-in user.
# Set the variables below only when you want to run against real infrastructure.

# --- Demo mode -------------------------------------------------------------
# Force demo mode on even when MONGODB_URI / Auth0 are configured.
# NEXT_PUBLIC_DEMO_MODE=true

# --- Database --------------------------------------------------------------
# Setting this switches persistence from the in-memory store to MongoDB.
# MONGODB_URI=mongodb://localhost:27017/parceflyte

# --- Auth0 -----------------------------------------------------------------
# Setting all of these switches auth from the demo session to real Auth0.
# Generate the secret with: openssl rand -hex 32
# AUTH0_SECRET=
# AUTH0_BASE_URL=http://localhost:3000
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=https://api.parceflyte.com
# AUTH0_SCOPE=openid profile email
